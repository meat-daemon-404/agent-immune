{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dsh-immune-system/dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["core/**/*.ts", "zcode/src/**/*.ts", "dsh/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "dsh-immune-system"]
}
