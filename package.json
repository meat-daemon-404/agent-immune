{
  "name": "dsh-immune-system",
  "version": "2.3.0",
  "description": "Self-evolving pitfall immunity for coding agents (Claude Code, Codex, Cursor, Google Antigravity, Gemini CLI, Windsurf, ZCode, DSH, MCP): capture failed-then-fixed tool episodes as SQLite+FTS5 antibodies and inject them before the agent repeats the mistake. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meat-daemon-404/agent-immune.git"
  },
  "homepage": "https://github.com/meat-daemon-404/agent-immune",
  "bugs": {
    "url": "https://github.com/meat-daemon-404/agent-immune/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "dsh-immune-system/dist/dsh/src/index.js",
  "bin": {
    "dsh-immune-system": "dsh-immune-system/dist/zcode/src/cli.js",
    "immune": "dsh-immune-system/dist/zcode/src/cli.js"
  },
  "exports": {
    ".": "./dsh-immune-system/dist/dsh/src/index.js",
    "./core": {
      "types": "./dsh-immune-system/dist/core/index.d.ts",
      "default": "./dsh-immune-system/dist/core/index.js"
    },
    "./client": "./dsh-immune-system/client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "id": "dsh-immune-system",
    "name": "DSH Immune System",
    "version": "2.3.0",
    "repo": "meat-daemon-404/agent-immune",
    "permissions": "读取工具调用结果与斜杠命令输入；在本机写 SQLite 抗体库（默认落在 $DSH_HOME/storages/dsh-immune-system/ 下按项目隔离）；仅在显式配置 IMMUNE_LLM_BASE_URL 与 IMMUNE_LLM_MODEL 时才向该端点发起请求；不读取其它插件的配置，不执行任意命令",
    "bundle": {
      "patch": "./dsh-immune-system/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "files": [
    "dsh-immune-system/dist/**/*.js",
    "dsh-immune-system/dist/**/*.d.ts",
    "dsh-immune-system/cordis.patch.yml",
    "dsh-immune-system/package.json",
    "dsh-immune-system/README.md",
    "README.md",
    "LICENSE",
    "dsh-immune-system/client/**/*.js"
  ],
  "keywords": [
    "coding-agents",
    "claude-code",
    "claude-plugin",
    "codex",
    "cursor",
    "antigravity",
    "gemini-cli",
    "windsurf",
    "mcp",
    "mcp-server",
    "agent-memory",
    "self-improving",
    "hooks",
    "pitfalls",
    "sqlite",
    "fts5",
    "ci-gate",
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "cordis-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node scripts/check-versions.mjs && node scripts/verify-dist-integrity.mjs",
    "bench": "node scripts/bench-recall.mjs && node scripts/bench-seed-recall.mjs && node scripts/bench-scale.mjs",
    "verify": "npm run build && npm run check && npm test && node scripts/bench-recall.mjs && node scripts/bench-seed-recall.mjs && node scripts/verify-connected-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0"
  }
}
