{
  "name": "dsh-immune-system",
  "version": "1.0.23",
  "description": "Self-evolving pitfall immunity for DeepSeek Harness: capture every failed-then-fixed tool episode, distil it into a reusable antibody stored in SQLite+FTS5, and inject the relevant ones before the agent repeats the mistake.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meat-daemon-404/dsh-plugin-immune.git"
  },
  "homepage": "https://github.com/meat-daemon-404/dsh-plugin-immune",
  "bugs": {
    "url": "https://github.com/meat-daemon-404/dsh-plugin-immune/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "dsh-immune-system/dist/dsh/src/index.js",
  "bin": {
    "dsh-immune-system": "dsh-immune-system/dist/zcode/src/cli.js"
  },
  "exports": {
    ".": "./dsh-immune-system/dist/dsh/src/index.js",
    "./client": "./dsh-immune-system/client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "id": "dsh-immune-system",
    "name": "DSH Immune System",
    "version": "1.0.23",
    "repo": "meat-daemon-404/dsh-plugin-immune",
    "permissions": "读取工具调用结果与斜杠命令输入；在本机写 SQLite 抗体库（默认落在 $DSH_HOME/storages/dsh-immune-system/ 下按项目隔离）；仅在显式配置 IMMUNE_LLM_BASE_URL 与 IMMUNE_LLM_MODEL 时才向该端点发起请求；不读取其它插件的配置，不执行任意命令",
    "bundle": {
      "patch": "./dsh-immune-system/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "files": [
    "dsh-immune-system/dist/**/*.js",
    "dsh-immune-system/cordis.patch.yml",
    "dsh-immune-system/package.json",
    "dsh-immune-system/README.md",
    "README.md",
    "LICENSE",
    "dsh-immune-system/client/**/*.js"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "cordis-plugin",
    "ai-agent",
    "self-improving",
    "memory",
    "pitfalls",
    "sqlite"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
